---  **********************************************************
-- Dekolink MIB Notification object definitions
--

    dekoNotificationsPrefix	OBJECT IDENTIFIER ::= { dekoNotificationManagement 1 }
    
    dekoNotifications	OBJECT IDENTIFIER ::= { dekoNotificationsPrefix 0 } 
    
---

dekoNewAlarmNotification NOTIFICATION-TYPE
	OBJECTS {
	dekoTrapNotificationId,
	dekoTrapAlarmId,
	dekoTrapMngrSnapId,
	dekoTrapMngrName,
	dekoTrapRptrSnapId,
	dekoTrapRptrName,
	dekoTrapAlarmTime,
	dekoTrapAlarmText,
	dekoTrapAlarmSeverity,
	dekoTrapAlarmAdditionalText,
	dekoTrapAlarmGPS
	}
    STATUS  current
    DESCRIPTION
        "NE new raised alarm notification."
    ::= { dekoNotifications 10 }  

---

  dekoClearAlarmNotification NOTIFICATION-TYPE
	OBJECTS {   
    dekoTrapNotificationId,    
    dekoTrapAlarmId,
    dekoTrapMngrSnapId,          
    dekoTrapMngrName,          
    dekoTrapRptrSnapId,          
    dekoTrapRptrName,          
    dekoTrapAlarmTime,
    dekoTrapAlarmSeverity,
    dekoTrapAlarmText,
    dekoTrapAlarmAdditionalText,
    dekoTrapAlarmGPS }
    STATUS  current
    DESCRIPTION
        "NE clear alarm notification."
    ::= { dekoNotifications 20 }    
    
--- 
   
  dekoHeartbeatNotification NOTIFICATION-TYPE
	OBJECTS {   
    dekoHBNotificationId,    
    dekoTrapNotificationId,    
    dekoTrapMngrSnapId,          
    dekoTrapRptrSnapId,
    dekoTrapAdditionalData,    
    dekoTrapPhoneNumber,
    dekoTrapConnectionType,
    dekoTrapMngrVersion
 	}
    STATUS  current
    DESCRIPTION
        "Heartbeat notification."
    ::= { dekoNotifications 30 }    
    
---
--- Notification Variables
---

  dekoNotificationObjects OBJECT IDENTIFIER
    ::= { dekoNotificationManagement 20 }

  dekoHBNotificationId	OBJECT-TYPE	
		SYNTAX			Counter32
		MAX-ACCESS		accessible-for-notify
		STATUS			current
		DESCRIPTION		
				"The system-wide unique ID of the Heartbeat Alarm.
         Independent counter from notification id of other traps.
         When it reaches the	maximum value of a unsigned 32-bit
         integer, it restarts at 1."
		::=  {  dekoNotificationObjects  1  }

  dekoTrapNotificationId	OBJECT-TYPE	
		SYNTAX			Counter32
		MAX-ACCESS		accessible-for-notify
		STATUS			current
		DESCRIPTION		
				"The ID of the last Alarm Notification. This number
				 starts at 1 and is incremented by 1 for each
				 subsequent New or Clear Alarm notification. When it
         reaches the	maximum value of a unsigned 32-bit integer,
         it restarts at 1."
		::=  {  dekoNotificationObjects  2  }

   dekoTrapAlarmId 	OBJECT-TYPE	
		SYNTAX			Counter32
		MAX-ACCESS		accessible-for-notify
		STATUS			current
		DESCRIPTION		
				"unique id of the raised alarm."
		::=  {  dekoNotificationObjects  3  }

  dekoTrapMngrSnapId	OBJECT-TYPE	
		SYNTAX			DisplayString 
		MAX-ACCESS		accessible-for-notify
		STATUS			current
		DESCRIPTION		
				"Unique SNAP ID for NE in Dekolink
				 System that generated the Alarm."
		::=  {  dekoNotificationObjects  4  }		

  dekoTrapRptrSnapId	OBJECT-TYPE	
		SYNTAX			DisplayString 
		MAX-ACCESS		accessible-for-notify
		STATUS			current
		DESCRIPTION		
				"Unique SNAP ID for NE in Dekolink
				 System that generated the Alarm."
		::=  {  dekoNotificationObjects  5  }		

  dekoTrapPhoneNumber	OBJECT-TYPE	
		SYNTAX			DisplayString
		MAX-ACCESS		accessible-for-notify
		STATUS			current
		DESCRIPTION		
				"Manager Telephone number in alarm notification."
		::=  {  dekoNotificationObjects  6  }		

  dekoTrapConnectionType	OBJECT-TYPE	
		SYNTAX INTEGER {
			direct(1),
			alwayson(2),
			callback(3),
			indeterminate(99)
		}
		MAX-ACCESS		accessible-for-notify
		STATUS			current
		DESCRIPTION		
				"Manager connection type in alarm notification.
				Values are:
				
					1 - Direct for fixed ip - LAN connection 
					2 - Alwayson for fixed ip WAN connection via modem
					3 - callback for connection via modem that wakes the server.
					    Server gets the callback call and initiates the connection from its side
					99 - Indeterminate."
          
		::=  {  dekoNotificationObjects  7  }		

    dekoTrapAlarmSeverity	OBJECT-TYPE	
		SYNTAX INTEGER {
			indeterminate(1),
			critical(2),
			major(3),
			minor(4),
			warning(5),
			cleared(6)
		}
		MAX-ACCESS		accessible-for-notify
		STATUS			current
		DESCRIPTION		
				"Severity of the alarm notification:
					1 - Indeterminate  
					2 - Critical
					3 - Major
					4 - Minor
					5 - Warning
					6 - Cleared ."
		::=  {  dekoNotificationObjects  8  }

    dekoTrapAlarmTime	OBJECT-TYPE	
		SYNTAX			DateAndTime
		MAX-ACCESS	accessible-for-notify
		STATUS			current
		DESCRIPTION		
				"Date/Time of the Alarm."
		::=  {  dekoNotificationObjects  9  }

    dekoTrapAlarmText	OBJECT-TYPE	
		SYNTAX			DisplayString 
		MAX-ACCESS		accessible-for-notify
		STATUS			current
		DESCRIPTION		
				"basic description of the problem that
				caused the alarm."
		::=  {  dekoNotificationObjects  10  }		
	
    dekoTrapAlarmAdditionalText	OBJECT-TYPE	
		SYNTAX			DisplayString 
		MAX-ACCESS		accessible-for-notify
		STATUS			current
		DESCRIPTION		
				"further qualification on the fault."
		::=  {  dekoNotificationObjects  11  }
	
    dekoTrapAdditionalData	OBJECT-TYPE	
		SYNTAX			DisplayString 
		MAX-ACCESS		accessible-for-notify
		STATUS			current
		DESCRIPTION		
				"Additional data for heartbeat trap."
		::=  {  dekoNotificationObjects  12  } 
	
    dekoTrapMngrName	OBJECT-TYPE	
		SYNTAX			DisplayString 
		MAX-ACCESS		accessible-for-notify
		STATUS			current
		DESCRIPTION		
				"Manager name notificatoin."
		::=  {  dekoNotificationObjects  13  } 
	
    dekoTrapRptrName	OBJECT-TYPE	
		SYNTAX			DisplayString 
		MAX-ACCESS	accessible-for-notify
		STATUS			current
		DESCRIPTION		
				"Repeater name notificatoin."
		::=  {  dekoNotificationObjects  14  } 
	
    dekoTrapMngrVersion	OBJECT-TYPE	
		SYNTAX			DisplayString 
		MAX-ACCESS	accessible-for-notify
		STATUS			current
		DESCRIPTION		
				"Manager name notificatoin."
		::=  {  dekoNotificationObjects  15  } 
	
    dekoTrapAlarmGPS	OBJECT-TYPE
		SYNTAX			DisplayString 
		MAX-ACCESS		accessible-for-notify
		STATUS			current
		DESCRIPTION		
			"GPS position."
		::=  {  dekoNotificationObjects  16  }
	
    dekoTrapMngrIPStatic	OBJECT-TYPE
		SYNTAX			DisplayString 
		MAX-ACCESS		accessible-for-notify
		STATUS			current
		DESCRIPTION		
			"Static IP Address."
		::=  {  dekoNotificationObjects  17  }
	
    dekoTrapMngrIPDynamic	OBJECT-TYPE
		SYNTAX			DisplayString 
		MAX-ACCESS		accessible-for-notify
		STATUS			current
		DESCRIPTION		
			"Dynamic IP Address."
		::=  {  dekoNotificationObjects  18  }
		
    dekoTrapMngrIPModem	OBJECT-TYPE
		SYNTAX			DisplayString 
		MAX-ACCESS		accessible-for-notify
		STATUS			current
		DESCRIPTION		
			"Modem IP Address."
		::=  {  dekoNotificationObjects  19  }
--
-- Conformance
--

dekoMIBConformance OBJECT IDENTIFIER ::= { dekoMIB 3 }

dekoMIBCompliances OBJECT IDENTIFIER ::= { dekoMIBConformance 1 }

dekoMIBGroups      OBJECT IDENTIFIER ::= { dekoMIBConformance 2 }


---
--- Compliance
--- 
    
--+++++++++++++++++++++++++

dekoMIBComplianceNe MODULE-COMPLIANCE
     STATUS current
     DESCRIPTION
         "The compliance statement for the NE groups on the Dekolink MIB."
     MODULE
     MANDATORY-GROUPS { 
		dekoAlarmsObjGroup,
		dekoInventoryObjGroup
	}
     ::= { dekoMIBCompliances 1 }          

--  *********************************
-- Units of Conformance
--
--


dekoAlarmsObjGroup OBJECT-GROUP
	OBJECTS {
	dekoAlarmNotificationId,
	dekoAlarmId,
	dekoAlarmMngrSnapId,
	dekoAlarmMngrName,
	dekoAlarmRptrSnapId,
	dekoAlarmRptrName,
	dekoAlarmTime,
	dekoAlarmText,
	dekoAlarmSeverity,
	dekoAlarmAdditionalText,
	dekoAlarmLogNotificationId,
	dekoAlarmLogId,
	dekoAlarmLogMngrSnapId,
	dekoAlarmLogMngrName,
	dekoAlarmLogRptrSnapId,
	dekoAlarmLogRptrName,
	dekoAlarmLogTime,
	dekoAlarmLogText,
	dekoAlarmLogSeverity,
	dekoAlarmLogAdditionalText,
	dekoAlarmsSystemCounter
	}
    STATUS current
    DESCRIPTION
        "A collection of objects providing the global configuration
        and information for NE Alarms Management."
    ::= { dekoMIBGroups 1 }

--
    
--+++++++++++++++++++++++++

dekoMIBComplianceNotifications MODULE-COMPLIANCE
     STATUS current
     DESCRIPTION
         "The compliance statement for manager notifications group on the Dekolink MIB."
     MODULE
     MANDATORY-GROUPS { 
     	dekoNotificationsGroup,
     	dekoVariablesGroup  
     }
     ::= { dekoMIBCompliances 2 }

--  *********************************
-- Units of Conformance
--

dekoNotificationsGroup NOTIFICATION-GROUP
	NOTIFICATIONS {
		dekoNewAlarmNotification,
		dekoClearAlarmNotification,
		dekoHeartbeatNotification
	}
    STATUS current
    DESCRIPTION
        "A collection of Notifications (Traps) used by the snmp agent." 
    ::= { dekoMIBGroups 2 }
    
dekoVariablesGroup OBJECT-GROUP
	OBJECTS {
	dekoHBNotificationId,
	dekoTrapNotificationId,
	dekoTrapAlarmId,
	dekoTrapMngrSnapId,
	dekoTrapMngrName,
	dekoTrapRptrSnapId,
	dekoTrapRptrName,
	dekoTrapAlarmTime,
	dekoTrapAlarmText,
	dekoTrapAlarmSeverity,
	dekoTrapAlarmAdditionalText,
	dekoTrapPhoneNumber,
	dekoTrapConnectionType,
	dekoTrapMngrVersion,
	dekoTrapAdditionalData,
	dekoTrapAlarmGPS,
	dekoTrapMngrIPStatic,
	dekoTrapMngrIPDynamic,
	dekoTrapMngrIPModem
	}
    STATUS current
    DESCRIPTION
        "A collection of objects providing the global configuration
        and information for Fault Manager notification." 
    ::= { dekoMIBGroups 3 }

dekoInventoryObjGroup OBJECT-GROUP
	OBJECTS {
	dekoRptrSnapId,
	dekoRptrName,
	dekoMngrSnapid,
	dekoMngrName,
	dekoMngrVersion,
	dekoRptrOperationState,
	dekoConnectionType,
	dekoPhoneNumber,
	stadlerLanIP,
	stadlerModemIP,
	stadlerCoachID,
	stadlerRptrName,
	stadlerRptrPN,
	stadlerSysVer,
	stadlerSysTime,
	stadlerConfVer,
	stadlerGPSPos,
	stadlerState,
	axellNeIdIndex,
	axellNeSystemType,
	axellNeRepeaterPartNumber,
	axellNeRepeaterSerialNumber,
	axellNeRepeaterIdentification,
	axellNeRFTransmissionEnable,
	axellNeMaxPowerDL,
	axellNeMaxPowerUL,
	axellNeDLOutputThresholdDelta,
	axellNeTemperature,
	axellNeOutputPowerDL,
	axellNeOscillationPrevention,
	axellNeRFTransmissionEnableB,
	axellNeOscillationPreventionB,
	axellNeMaxPowerDLB,
	axellNeMaxPowerULB,
	axellNeDLOutputThresholdDeltaB,
	axellNeOutputPowerDLB,
	axellNeIMMuteEnable,
	axellNeBuildVersion,
	axellNePathADlUlShift,
	axellNePathAName,
	axellNePathBDlUlShift,
	axellNePathBName,
	axellNePossibleFilters,
	axellNeIndex,
	axellNeId,
	axellNeBandIndex,
	axellNeDlMesRSSI,
	axellNeDlMesChPower,
	axellNeDlMesChGain,
	axellNeUlMesRSSI,
	axellNeUlMesChPower,
	axellNeUlMesChGain,
	axellNeENABLED,
	axellNeFilterType,
	axellNeDlFreqStart,
	axellNeDlSquelchLevel,
	axellNeDlMaxPower,
	axellNeDlMaxGain,
	axellNeDlFreqStop,
	axellNeUlSquelchLevel,
	axellNeUlMaxPower,
	axellNeUlMaxGain,
	axellNeImopGainReduction,
	axellNeDlIsolation,
	axellNeUlIsolation
	}
	STATUS current
	DESCRIPTION
		"A collection of objects providing the global configuration
		and information for NE Inventory Management." 
	::= { dekoMIBGroups 4 } 


axellOperationMultipleTable OBJECT-TYPE
         SYNTAX  SEQUENCE OF AxellOperationMultipleEntry
         MAX-ACCESS  not-accessible
         STATUS  current
         DESCRIPTION
         "OperationMultipleTable - Contains the NE' working parameters.
          Use numerical counter as index"
     ::= { axellOperationGroup  20 }

     axellOperationMultipleEntry OBJECT-TYPE
         SYNTAX  AxellOperationMultipleEntry
         MAX-ACCESS  not-accessible
         STATUS  current
         DESCRIPTION
         "The entries of the table."
         INDEX { axellNeIndex }
     ::= { axellOperationMultipleTable 1 }

     AxellOperationMultipleEntry ::= SEQUENCE
     {
          axellNeIndex                             Counter32,
          axellNeId                                DisplayString,
          axellNeBandIndex                         DisplayString,
          axellNeDlMesRSSI                         DisplayString,
          axellNeDlMesChPower                      DisplayString,
          axellNeDlMesChGain                       DisplayString,
          axellNeUlMesRSSI                         DisplayString,
          axellNeUlMesChPower                      DisplayString,
          axellNeUlMesChGain                       DisplayString,
          axellNeENABLED                           DisplayString,

DEKOLINK-NE-MIB DEFINITIONS ::= BEGIN

IMPORTS
  MODULE-IDENTITY, OBJECT-TYPE, NOTIFICATION-TYPE,
	enterprises, Counter32
    FROM SNMPv2-SMI
  MODULE-COMPLIANCE, OBJECT-GROUP, NOTIFICATION-GROUP
    FROM SNMPv2-CONF
  DisplayString, DateAndTime
    FROM SNMPv2-TC ;

--
-- Module Identity
--

dekoMIB MODULE-IDENTITY
    LAST-UPDATED    "201307140000Z"
    ORGANIZATION    "Dekolnk"
    CONTACT-INFO
        "       Dekolnk Wireless

                Postal: P.O. Box 10018 
				Petah Tikva, 
				ISRAEL 49001
                Tel:  972-3-9180180
                Fax: 972-3-9180190
                E-Mail: marketing@dekolink.com "
 
               
   DESCRIPTION
        "The DEKOLINK-NE-MIB module contains a description of
	the SNMP interface to the Dekolink NE version 1.0.	
	"
    REVISION   "200704100000Z"
    DESCRIPTION
        "Initial released version of this MIB module."
    ::= { dekolinkwireless 200 }  
  
  
dekolinkwireless OBJECT IDENTIFIER ::= { enterprises 23792 } 

--
-- Dekolink module MIB Managed Objects
--
dekoModuleManagement OBJECT IDENTIFIER    
    ::= { dekoMIB 1 }
          
--
-- Dekolink module MIB Notification Objects
--
dekoNotificationManagement OBJECT IDENTIFIER
    ::= { dekoMIB 2 }
      


--   ************************************************************
-- 		Modules
--

dekoModules		 OBJECT IDENTIFIER ::= { dekoModuleManagement 1 }
dekoNEModule		 OBJECT IDENTIFIER ::= { dekoModules 10 }

--- ************************************************************
--- Dekolink NE Module Structure
---
                                                                                         
dekoAlarmsGroup           OBJECT IDENTIFIER ::= { dekoNEModule 2 }
dekoAlarmsLogGroup        OBJECT IDENTIFIER ::= { dekoNEModule 3 }
dekoInventoryGroup        OBJECT IDENTIFIER ::= { dekoNEModule 4 }
axellOperationGroup       OBJECT IDENTIFIER ::= { dekoNEModule 5 }
stadlerCCDInventoryGroup  OBJECT IDENTIFIER ::= { dekoNEModule 10 }


-- ~~~~~~~~~~~~~ Alarms group  ~~~~~~~~~~~~~~~~~~

  	dekoAlarmsTable	OBJECT-TYPE
         SYNTAX  SEQUENCE OF DekoAlarmsEntry
         MAX-ACCESS  not-accessible
         STATUS  current
         DESCRIPTION
         "AlarmsTable - Contains the NE' Alarms.
          Use neID as index"
     ::= { dekoAlarmsGroup  10 }

     dekoAlarmsEntry	OBJECT-TYPE
         SYNTAX  DekoAlarmsEntry
         MAX-ACCESS  not-accessible
         STATUS  current
         DESCRIPTION
         "The entries of the table."
         INDEX { dekoAlarmNotificationId }
     ::= { dekoAlarmsTable 1 }

		DekoAlarmsEntry ::= SEQUENCE
		{
      dekoAlarmNotificationId  Counter32,
      dekoAlarmId              Counter32,
      dekoAlarmMngrSnapId      DisplayString,
      dekoAlarmMngrName        DisplayString,
      dekoAlarmRptrSnapId      DisplayString,
      dekoAlarmRptrName        DisplayString,
      dekoAlarmTime            DateAndTime,
      dekoAlarmText            DisplayString,
      dekoAlarmSeverity        INTEGER,
      dekoAlarmAdditionalText  DisplayString           
		}

    dekoAlarmNotificationId	OBJECT-TYPE	
  		SYNTAX			Counter32
  		MAX-ACCESS	read-only
  		STATUS			current
  		DESCRIPTION		
  				"table index. global notification counter in the system."
		::=  {  dekoAlarmsEntry 1  }

    dekoAlarmId	OBJECT-TYPE	
  		SYNTAX			Counter32
  		MAX-ACCESS	read-only
  		STATUS			current
  		DESCRIPTION		
  				"Global notification counter of correlated new alarm in the system.
           Each time a new Alarm is raised, this value will be equal to
           the dekoAlarmNotificationId."
		::=  {  dekoAlarmsEntry 2  }

     dekoAlarmMngrSnapId	OBJECT-TYPE
  		 SYNTAX    DisplayString   ( SIZE (8) )
  		 MAX-ACCESS read-only
  		 STATUS    current
  		 DESCRIPTION
  		 "The Manager Snap Id. Unique identification in the system." 
     ::= { dekoAlarmsEntry  3 } 
	 
    dekoAlarmMngrName	OBJECT-TYPE	
  		SYNTAX			DisplayString 
  		MAX-ACCESS	read-only
  		STATUS			current
  		DESCRIPTION		
  				"Manager name associated to repeater that initiates the alarm."
		::=  {  dekoAlarmsEntry 4  } 

    dekoAlarmRptrSnapId	OBJECT-TYPE	
  		 SYNTAX    DisplayString   ( SIZE (8) )
  		 MAX-ACCESS    read-only
  		 STATUS    current
  		 DESCRIPTION
  		 "The Manager Snap Id. Unique identification in the system." 
		::=  {  dekoAlarmsEntry 5  }		

    dekoAlarmRptrName	OBJECT-TYPE	
  		SYNTAX			DisplayString 
  		MAX-ACCESS	read-only
  		STATUS			current
  		DESCRIPTION		
  				"Repeater name of the NE that initiates the alarm."
		::=  {  dekoAlarmsEntry 6  } 

    dekoAlarmTime	OBJECT-TYPE	
  		SYNTAX			DateAndTime
  		MAX-ACCESS	read-only
  		STATUS			current
  		DESCRIPTION		
  				"Date/Time of the Alarm."
		::=  {  dekoAlarmsEntry 7  }

    dekoAlarmText	OBJECT-TYPE	
  		SYNTAX			DisplayString 
  		MAX-ACCESS	read-only
  		STATUS			current
  		DESCRIPTION		
  				"basic description of the problem that
  				caused the alarm."
		::=  {  dekoAlarmsEntry 8 }		
		
    dekoAlarmSeverity	OBJECT-TYPE	
  		SYNTAX INTEGER {
  			indeterminate(1),
  			critical(2),
  			major(3),
  			minor(4),
  			warning(5),
  			cleared(6)
  		}
  		MAX-ACCESS	read-only
  		STATUS			current
  		DESCRIPTION		
  				"Alarm Severity:
  					1 - Indeterminate
  					2 - Critical
  					3 - Major
  					4 - Minor
  					5 - Warning
  					6 - Cleared "
		::=  {  dekoAlarmsEntry 9  }

    dekoAlarmAdditionalText	OBJECT-TYPE	
  		SYNTAX			DisplayString 
  		MAX-ACCESS	read-only
  		STATUS			current
  		DESCRIPTION		
  				"further qualification on the alarm."
		::=  {  dekoAlarmsEntry 10  }
		
  dekoAlarmsSystemCounter OBJECT-TYPE	
  		SYNTAX      Counter32 
  		MAX-ACCESS	read-only
  		STATUS			current
  		DESCRIPTION		
  				"Dekolink system global alarms counter."
		::=  {  dekoAlarmsGroup 20  }

-- ~~~~~~~~~~~~~ Alarms Log group  ~~~~~~~~~~~~~~~~~~

	dekoAlarmsLogTable	OBJECT-TYPE
         SYNTAX  SEQUENCE OF DekoAlarmsLogEntry
         MAX-ACCESS  not-accessible
         STATUS  current
         DESCRIPTION
         "AlarmsTable - Contains the NE' Alarms.
          Use neID as index"
     ::= { dekoAlarmsLogGroup  20 }

     dekoAlarmsLogEntry	OBJECT-TYPE
         SYNTAX  DekoAlarmsLogEntry
         MAX-ACCESS  not-accessible
         STATUS  current
         DESCRIPTION
         "The entries of the table."
         INDEX { dekoAlarmLogNotificationId }
     ::= { dekoAlarmsLogTable 1 }

		DekoAlarmsLogEntry ::= SEQUENCE
		{
      dekoAlarmLogNotificationId  Counter32,
      dekoAlarmLogId              Counter32,
      dekoAlarmLogMngrSnapId      DisplayString,          
      dekoAlarmLogMngrName        DisplayString,  
      dekoAlarmLogRptrSnapId      DisplayString,    
      dekoAlarmLogRptrName        DisplayString,  
      dekoAlarmLogTime            DateAndTime,
      dekoAlarmLogText            DisplayString,
      dekoAlarmLogSeverity        INTEGER,
      dekoAlarmLogAdditionalText  DisplayString  
		}

    dekoAlarmLogNotificationId	OBJECT-TYPE	
  		SYNTAX			Counter32
  		MAX-ACCESS	read-only
  		STATUS			current
  		DESCRIPTION		
  				"table index. global notification counter in the system."
		::=  {  dekoAlarmsLogEntry 1  }

    dekoAlarmLogId	OBJECT-TYPE	
  		SYNTAX			Counter32
  		MAX-ACCESS	read-only
  		STATUS			current
  		DESCRIPTION		
  				"Global notification counter of correlated new alarm in the system.
           Each time a new Alarm is raised, this value will be equal to
           the dekoAlarmLogNotificationId."
		::=  {  dekoAlarmsLogEntry 2  }

     dekoAlarmLogMngrSnapId	OBJECT-TYPE
  		 SYNTAX    DisplayString   ( SIZE (8) )
  		 MAX-ACCESS read-only
  		 STATUS    current
  		 DESCRIPTION
  		 "The Manager Snap Id. Unique identification in the system." 
     ::= { dekoAlarmsLogEntry  3 } 
	 
    dekoAlarmLogMngrName	OBJECT-TYPE	
  		SYNTAX			DisplayString 
  		MAX-ACCESS	read-only
  		STATUS			current
  		DESCRIPTION		
  				"Manager name associated to repeater that initiates the alarm."
		::=  {  dekoAlarmsLogEntry 4  } 

    dekoAlarmLogRptrSnapId	OBJECT-TYPE	
  		 SYNTAX    DisplayString   ( SIZE (8) )
  		 MAX-ACCESS    read-only
  		 STATUS    current
  		 DESCRIPTION
  		 "The Manager Snap Id. Unique identification in the system." 
		::=  {  dekoAlarmsLogEntry 5  }		

    dekoAlarmLogRptrName	OBJECT-TYPE	
  		SYNTAX			DisplayString 
  		MAX-ACCESS	read-only
  		STATUS			current
  		DESCRIPTION		
  				"Repeater name of the NE that initiates the alarm."
		::=  {  dekoAlarmsLogEntry 6  } 

    dekoAlarmLogTime	OBJECT-TYPE	
  		SYNTAX			DateAndTime
  		MAX-ACCESS	read-only
  		STATUS			current
  		DESCRIPTION		
  				"Date/Time of the Alarm."
		::=  {  dekoAlarmsLogEntry 7  }

    dekoAlarmLogText	OBJECT-TYPE	
  		SYNTAX			DisplayString 
  		MAX-ACCESS	read-only
  		STATUS			current
  		DESCRIPTION		
  				"basic description of the problem that
  				caused the alarm."
		::=  {  dekoAlarmsLogEntry 8 }		
		
    dekoAlarmLogSeverity	OBJECT-TYPE	
  		SYNTAX INTEGER {
  			indeterminate(1),
  			critical(2),
  			major(3),
  			minor(4),
  			warning(5),
  			cleared(6)
  		}
  		MAX-ACCESS	read-only
  		STATUS			current
  		DESCRIPTION		
  				"Alarm Severity:
  					1 - Indeterminate
  					2 - Critical
  					3 - Major
  					4 - Minor
  					5 - Warning
  					6 - Cleared "
		::=  {  dekoAlarmsLogEntry 9  }

    dekoAlarmLogAdditionalText	OBJECT-TYPE	
  		SYNTAX			DisplayString 
  		MAX-ACCESS	read-only
  		STATUS			current
  		DESCRIPTION		
  				"further qualification on the alarm."
		::=  {  dekoAlarmsLogEntry 10  }
		

-- ~~~~~~~~~~~~~ Inventory group  ~~~~~~~~~~~~~~~~~~

  	dekoInventoryTable	OBJECT-TYPE
         SYNTAX  SEQUENCE OF DekoInventoryEntry
         MAX-ACCESS  not-accessible
         STATUS  current
         DESCRIPTION
         "InventoryTable - Contains the NE' inventory data.
          Use repeater snap id as index"
     ::= { dekoInventoryGroup  10 }

     dekoInventoryEntry	OBJECT-TYPE
         SYNTAX  DekoInventoryEntry
         MAX-ACCESS  not-accessible
         STATUS  current
         DESCRIPTION
         "The entries of the table."
         INDEX { dekoRptrSnapId }
     ::= { dekoInventoryTable 1 }

		DekoInventoryEntry ::= SEQUENCE
		{
      dekoRptrSnapId           DisplayString,    
      dekoRptrName             DisplayString,    
      dekoMngrSnapid           DisplayString,    
      dekoMngrName             DisplayString,
      dekoMngrVersion          DisplayString,
      dekoRptrOperationState   INTEGER,          
      dekoConnectionType       INTEGER,
      dekoPhoneNumber          DisplayString
		}

     dekoRptrSnapId	OBJECT-TYPE
  		 SYNTAX    DisplayString   ( SIZE (8) )
  		 MAX-ACCESS read-only
  		 STATUS    current
  		 DESCRIPTION
  		 "Repeater snap id. Unique identification in the system." 
     ::= { dekoInventoryEntry  1 } 
	 
    dekoRptrName	OBJECT-TYPE	
  		SYNTAX			DisplayString 
  		MAX-ACCESS	read-only
  		STATUS			current
  		DESCRIPTION		
  				"Repeater name."
		::=  {  dekoInventoryEntry 2  } 

    dekoMngrSnapid	OBJECT-TYPE	
  		 SYNTAX    DisplayString   ( SIZE (8) )
  		 MAX-ACCESS    read-only
  		 STATUS    current
  		 DESCRIPTION
  		 "The manager snap Id. Unique identification in the system." 
		::=  {  dekoInventoryEntry 3  }		

    dekoMngrName	OBJECT-TYPE	
  		SYNTAX			DisplayString 
  		MAX-ACCESS	read-only
  		STATUS			current
  		DESCRIPTION		
  				"The manager name."
		::=  {  dekoInventoryEntry 4  } 


    dekoMngrVersion	OBJECT-TYPE	
  		SYNTAX			DisplayString
  		MAX-ACCESS	read-only
  		STATUS			current
  		DESCRIPTION		
  				"Manager version."
		::=  {  dekoInventoryEntry 5  }

    dekoRptrOperationState	OBJECT-TYPE	
  		SYNTAX INTEGER {
  			indeterminate(1),
  			ok(2),
  			rptrdown(3)
  		}
  		MAX-ACCESS	read-only
  		STATUS			current
  		DESCRIPTION		
  				"Repeater operation state (OK, RF down):
  					1 - Indeterminate
  					2 - OK
  					3 - Repeater Down"
		::=  {  dekoInventoryEntry 6  }

    dekoConnectionType	OBJECT-TYPE	
  		SYNTAX INTEGER {
  			direct(1),
  			alwayson(2),
  			callback(3),
  			indeterminate(99)
  		}
  		MAX-ACCESS	read-only
  		STATUS			current
  		DESCRIPTION		
				"Manager connection type.
				Values are:
					1 - Direct for fixed ip - LAN connection 
					2 - Alwayson for fixed ip WAN connection via modem
					3 - callback for connection via modem that wakes the server.
					    Server gets the callback call and initiates the connection from its side
					99 - Indeterminate."
		::=  {  dekoInventoryEntry 7  }

    dekoPhoneNumber	OBJECT-TYPE	
  		SYNTAX			DisplayString
  		MAX-ACCESS	read-only
  		STATUS			current
  		DESCRIPTION		
				"Manager Telephone number."
		::=  {  dekoInventoryEntry  8  }		


-- ~~~~~~~~~~~~~ Operation group  ~~~~~~~~~~~~~~~~~~

axellOperationScalarsTable OBJECT-TYPE
         SYNTAX  SEQUENCE OF AxellOperationScalarsEntry
         MAX-ACCESS  not-accessible
         STATUS  current
         DESCRIPTION
         "OperationScalarsTable - Contains the NE' working parameters.
          Use numerical counter as index"
     ::= { axellOperationGroup  10 }

     axellOperationScalarsEntry OBJECT-TYPE
         SYNTAX  AxellOperationScalarsEntry
         MAX-ACCESS  not-accessible
         STATUS  current
         DESCRIPTION
         "The entries of the table."
         INDEX { axellNeIdIndex }
     ::= { axellOperationScalarsTable 1 }

     AxellOperationScalarsEntry ::= SEQUENCE
     {
          axellNeIdIndex                           Counter32,
          axellNeSystemType                        DisplayString,
          axellNeRepeaterPartNumber                DisplayString,
          axellNeRepeaterSerialNumber              DisplayString,
          axellNeRepeaterIdentification            DisplayString,
          axellNeRFTransmissionEnable              DisplayString,
          axellNeMaxPowerDL                        DisplayString,

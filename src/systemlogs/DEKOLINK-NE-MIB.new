          axellNeUlMaxGain                         DisplayString,
          axellNeImopGainReduction                 DisplayString,
          axellNeDlIsolation                       DisplayString,
          axellNeUlIsolation                       DisplayString
     }

     axellNeIndex OBJECT-TYPE
